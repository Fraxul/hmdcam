import os
Import('env')

calibrationEnv = env.Clone()
calibrationEnv.Append(
  CPPPATH=[
    '/usr/include/eigen3',
    '#calibration',
    '#calibration/industrial_calibration/core/include',
    '#calibration/industrial_calibration/optimizations/include',
  ],
)

# clang++ -Wall -I/usr/include/eigen3 solver-test.cpp -o solver-test -lceres -lglog

calibrationEnv.Program(
  target = '../bin/multiCameraCalibration',
  source = ['calibration/multiCameraCalibration.cpp'] +
    Glob('#calibration/industrial_calibration/core/src/*.cpp') +
    Glob('#calibration/industrial_calibration/optimizations/src/*.cpp'),

  LIBS = ['glog',
    'opencv_core', 'opencv_imgproc', 'opencv_imgcodecs', 'opencv_calib3d', 'opencv_aruco', 'opencv_objdetect',
    'pthread', 'rt',
    'boost_chrono', 'boost_filesystem', 'boost_system', 'boost_thread'
  ] + calibrationEnv['CERES_LIBS'],
)

calibrationEnv.Program(
  target = '../bin/charuco-benchmark',
  source = ['calibration/charuco-benchmark.cpp'],
  LIBS = ['opencv_core', 'opencv_imgproc', 'opencv_imgcodecs', 'opencv_calib3d', 'opencv_aruco', 'opencv_objdetect',
    'pthread', 'rt',
  ]
)

# Camera-IMU autosync calibrator (gyro <-> dense optical flow).
# Estimator core is hardware-independent; the synthetic self-test exercises it end-to-end
# and is the convention/sign guard (build and run this first).
# Shared, hardware-independent core objects -- compiled once with calibrationEnv and reused
# by both the self-test and the full tool (avoids two-environment object conflicts).
cameraImuCalibCore = [calibrationEnv.Object(s) for s in [
  'calibration/cameraImuCalibration/ImuTrace.cpp',
  'calibration/cameraImuCalibration/Intrinsics.cpp',
  'calibration/cameraImuCalibration/Estimator.cpp',
  'calibration/cameraImuCalibration/SyntheticFlowSource.cpp',
]]
cameraImuCalibLibs = ['glog',
  'opencv_core', 'opencv_imgproc', 'opencv_imgcodecs', 'opencv_calib3d',
  'pthread', 'rt',
] + calibrationEnv['CERES_LIBS']

calibrationEnv.Program(
  target = '../bin/cameraImuCalibrationSelfTest',
  source = cameraImuCalibCore + ['calibration/cameraImuCalibration/SelfTest.cpp'],
  LIBS = cameraImuCalibLibs,
)

# The full tool drives the Jetson Orin OFA for dense flow, so it only builds on Tegra. It
# reuses the in-tree CUDA/NvSci interop (rhi/cuda + common/tegra) rather than vendoring the
# nvmedia-iep helpers; only the PYDOF flow setup is tool-specific.
if calibrationEnv['IS_TEGRA']:
  ofaEnv = calibrationEnv.Clone()
  ofaEnv.Append(
    CPPPATH=[
      '#nvsci_headers',
      '#nvmedia',
      calibrationEnv['TEGRA_MMAPI'],
      calibrationEnv['TEGRA_MMAPI'] + '/include',
    ],
  )
  # Host-side front-end objects need no NvSci includes -> build with calibrationEnv.
  cameraImuFrontend = [calibrationEnv.Object(s) for s in [
    'calibration/cameraImuCalibration/FrameSequence.cpp',
    'calibration/cameraImuCalibration/ResultWriter.cpp',
  ]]
  # OFA + in-tree interop need the NvSci/NvMedia includes -> build with ofaEnv.
  cameraImuOfaSrc = [
    'calibration/cameraImuCalibration/OfaFlowSource.cpp',
    'calibration/cameraImuCalibration/OfaFlowUtil.cpp',
    'calibration/cameraImuCalibration/main.cpp',
    'rhi/cuda/RHICUDA.cpp',
    'rhi/cuda/CudaUtil.cpp',
    'common/tegra/NvSciCudaInterop.cpp',
    'common/tegra/NvSciUtil.cpp',
  ]
  cameraImuOfaLibs = [
    'nvmedia_iofa_sci', 'nvscibuf', 'nvscicommon', 'nvscievent', 'nvsciipc', 'nvscisync',
    'cuda', 'cudart',
  ]
  ofaEnv.Program(
    target = '../bin/cameraImuCalibration',
    source = cameraImuCalibCore + cameraImuFrontend + cameraImuOfaSrc,
    LIBS = cameraImuCalibLibs + cameraImuOfaLibs,
  )


# Standalone offline harness that replays a CalibrationWriter capture through the
# rolling-shutter de-skew math for visualization. Header-only dependencies on
# common/ (RollingShutterDeskew.h, glmCvInterop.h) plus OpenCV -- no CUDA/RHI.
rsEnv = env.Clone()
rsEnv.CompilationDatabase()

rsEnv.Program(
  target = '../bin/rollingShutterDeskewTest',
  source = [
    'calibration/rollingShutterDeskewTest.cpp',
  ],
  LIBS=['opencv_core', 'opencv_imgproc', 'opencv_calib3d', 'opencv_imgcodecs'],
)
