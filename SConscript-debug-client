Import('env')
Import('librhi', 'libimgui')

debugClientEnv = env.Clone()

debugClientEnv.Append(
  CPPPATH=['debug-client', '/usr/include/SDL2'],
  LIBS=[
    'z',
    'dl',
    'pthread', 'rt',
    'boost_chrono', 'boost_system', 'boost_thread',
    'SDL2',
    'epoxy',
    'cuda', 'cudart',
    'nppc', 'nppidei', 'nppicc', 'nppif',
    'opencv_core', 'opencv_imgproc', 'opencv_calib3d', 'opencv_aruco', 'opencv_objdetect', 'opencv_cudastereo',
  ]
)

tegraSrc = []
if debugClientEnv['IS_TEGRA']:
  debugClientEnv.Append(
    CPPPATH=[
      '#common/tegra',
      '#nvsci_headers',
      '#nvmedia',
    ],
    LIBS=[
      'nvmedia_iofa_sci',
      'nvscibuf', 'nvscicommon', 'nvscievent', 'nvsciipc', 'nvscisync',
    ],
  )
  tegraSrc = Glob('common/tegra/*.cpp')

debugClientEnv.CompilationDatabase()
debugClientEnv.ProgramWithWholeArchive(
  target = '../bin/debug-client', # relative to build/debug-client
  source = Glob('debug-client/*.cpp')
    + Glob('debug-client/*.cu')
    + Glob('common/*.cpp')
    + Glob('common/*.cu')
    + tegraSrc,
  whole_archive_libs = [librhi, libimgui]
)

